<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Same exclusion as backup_rules.xml, for both cloud backup and a
     device-to-device transfer: the account key is a credential, not data to
     copy. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="account/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="account/" />
    </device-transfer>
</data-extraction-rules>
